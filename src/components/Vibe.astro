---
import { isUnverified, type ProtestEvent } from '../lib/data';
import { isSerious, vibeClass, vibeLabel } from '../lib/format';
import { langOf, useT } from '../i18n';
interface Props { e: ProtestEvent; class?: string }
const { e, class: cls = '' } = Astro.props;
const lang = langOf(Astro.url);
const reader = isUnverified(e);
const v = reader ? 'reader' : vibeClass(e);
const serious = !reader && isSerious(e);
const pulsing = !serious && !reader && e.isOngoing && (v === 'heating-up' || v === 'peak-loud');
const t = useT(lang);
// Serious Mode always carries the red SERIOUS label; its state (wrapped up, soon) follows it.
const label = reader ? t('vibe.reader') : serious && v !== 'tense' ? `${t('vibe.tense')} · ${vibeLabel(e, lang)}` : vibeLabel(e, lang);
---
<span class:list={['sticker', `s-${serious ? 'tense' : v}`, { live: pulsing }, cls]}><span class="dot" aria-hidden="true"></span>{label}</span>
