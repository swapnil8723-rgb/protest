---
import type { ProtestEvent } from '../lib/data';
interface Props { e: ProtestEvent }
const { e } = Astro.props;
const serious = e.severity === 'serious';
const rows = [
  ['Why they are protesting', e.tea.why],
  ['What they want', e.tea.want],
  ['What changed', e.tea.changed],
].filter(([, v]) => v);
---
<section aria-labelledby="tea" class:list={['rounded-[22px] p-5 sm:p-6', serious ? 'serious-surface' : 'tea']}>
  <h2 id="tea" class="display text-[26px]">{serious ? 'Summary' : 'The Tea'}<span class="sr-only"> in three lines</span></h2>
  <dl class="mt-3 grid gap-3">
    {rows.map(([k, v]) => (
      <div>
        <dt class="text-[12px] font-bold uppercase tracking-[0.08em] opacity-70">{k}</dt>
        <dd class="text-[17px] font-semibold leading-snug sm:text-[18px]">{v}</dd>
      </div>
    ))}
  </dl>
</section>
<style>
  .tea { background: var(--yellow); color: #0b0b12; border: 3px solid #0b0b12; box-shadow: 6px 6px 0 var(--shadow-ink); }
  :root:not([data-theme='light']) .tea { box-shadow: 6px 6px 0 var(--violet); }
</style>
