---
import Logo from './Logo.astro';
import { activeCountries, cname, countryUrl, HUBS, hubUrl, lastRunAt } from '../lib/data';
import { BRAND, CONTACT } from '../site';
import { href, LANG_INFO, LANGS, langOf, useT, type Lang } from '../i18n';
interface Props { path: string; langs: readonly Lang[] }
const { path, langs } = Astro.props;
const lang = langOf(Astro.url);
const t = useT(lang);
---
<footer class="mt-24 border-t border-hairline">
  <div class="wrap grid gap-10 py-12 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <a href={href(lang, '/')} class="inline-flex min-h-11 items-center gap-2 no-underline"><Logo size={30} /><span class="display text-2xl">{BRAND}</span></a>
      <p class="mt-3 max-w-sm text-muted">{t('tagline')} {t('footer.about')}</p>
      <p class="mono mt-4 text-muted">{t('footer.lastRun')} <time data-rel datetime={lastRunAt}>{lastRunAt.slice(0, 16).replace('T', ' ')} UTC</time></p>
      <p class="eyebrow mb-2 mt-6">{t('footer.languages')}</p>
      <ul class="flex flex-wrap gap-x-1 text-[15px]">
        {LANGS.map((l) => <li><a href={href(l, langs.includes(l) ? path : '/')} hreflang={l} lang={l} class:list={['inline-flex min-h-11 items-center px-2 no-underline hover:underline', { 'font-bold': l === lang }]}>{LANG_INFO[l].native}</a></li>)}
      </ul>
    </div>
    <nav aria-label={t('footer.byCountry')}>
      <p class="eyebrow mb-3">{t('footer.byCountry')}</p>
      <ul class="grid grid-cols-2 gap-x-4 text-[15px]">
        {HUBS.filter((h) => h.list.length > 0).map((h) => <li><a href={hubUrl(h, lang)} class="flex min-h-11 items-center font-semibold no-underline hover:underline">{t(`hub.${h.key as 'europe'}.link`)}</a></li>)}
        {activeCountries.map((c) => <li><a href={countryUrl(c, lang)} class="flex min-h-11 items-center no-underline hover:underline">{cname(c, lang)}</a></li>)}
      </ul>
    </nav>
    <nav aria-label={t('footer.receipts')}>
      <p class="eyebrow mb-3">{t('footer.receipts')}</p>
      <ul class="grid text-[15px] [&_a]:flex [&_a]:min-h-11 [&_a]:items-center">
        <li><a href={href(lang, '/today')} class="no-underline hover:underline">{t('footer.today')}</a></li>
        <li><a href={href(lang, '/add')} class="no-underline hover:underline">{t('footer.add')}</a></li>
        <li><a href={href(lang, '/how-we-know')} class="no-underline hover:underline">{t('footer.how')}</a></li>
        <li><a href={href(lang, '/about')} class="no-underline hover:underline">{t('footer.aboutLink')}</a></li>
        <li><a href={href(lang, '/privacy')} class="no-underline hover:underline">{t('footer.privacy')}</a></li>
        <li><a href="/feed.xml" class="no-underline hover:underline">{t('footer.rss')}</a></li>
        <li><a href={`mailto:${CONTACT}`} class="no-underline hover:underline">{t('footer.corrections')} {CONTACT}</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-2 border-t border-hairline py-5 text-[13px] text-muted">
    <span>{t('footer.made')}</span>
    <span>{t('footer.credits')}</span>
  </div>
</footer>
