---
import Logo from './Logo.astro';
import { COUNTRIES, countryUrl, lastRunAt } from '../lib/data';
import { BRAND, CONTACT, TAGLINE } from '../site';
---
<footer class="mt-24 border-t border-hairline">
  <div class="wrap grid gap-10 py-12 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <a href="/" class="inline-flex items-center gap-2 no-underline"><Logo size={30} /><span class="display text-2xl">{BRAND}</span></a>
      <p class="mt-3 max-w-sm text-muted">{TAGLINE} A neutral protest tracker: every card cites at least two independent newsrooms.</p>
      <p class="mono mt-4 text-muted">Pipeline last ran <time data-rel datetime={lastRunAt}>{lastRunAt.slice(0, 16).replace('T', ' ')} UTC</time></p>
    </div>
    <nav aria-label="Countries">
      <p class="eyebrow mb-3">Protests by country</p>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-[15px]">
        {COUNTRIES.map((c) => <li><a href={countryUrl(c)} class="no-underline hover:underline">{c.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="About">
      <p class="eyebrow mb-3">The receipts</p>
      <ul class="grid gap-1.5 text-[15px]">
        <li><a href="/today" class="no-underline hover:underline">Protests today</a></li>
        <li><a href="/how-we-know" class="no-underline hover:underline">How we know (methods &amp; corrections)</a></li>
        <li><a href="/feed.xml" class="no-underline hover:underline">RSS feed</a></li>
        <li><a href={`mailto:${CONTACT}`} class="no-underline hover:underline">Corrections: {CONTACT}</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-2 border-t border-hairline py-5 text-[13px] text-muted">
    <span>Made loud, checked twice. Summaries are original; we link to the reporting.</span>
    <span>Map: Natural Earth (India's official boundaries) · Places: GeoNames (CC BY 4.0)</span>
  </div>
</footer>
