---
import { SITE } from '../site';
import { eventUrl, isUnverified, type ProtestEvent } from '../lib/data';
import { langOf, useT } from '../i18n';
interface Props { e: ProtestEvent }
const { e } = Astro.props;
const lang = langOf(Astro.url);
const t = useT(lang);
const url = `${SITE}${eventUrl(e, lang)}`;
const text = t('share.text', { title: e.title });
---
<div class="flex flex-wrap gap-2.5">
  {!isUnverified(e) && <button type="button" class="btn btn-candy" data-share-story={`/cards/${e.slug}-story.png`} data-url={url} data-title={e.title}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="3"/><path d="M12 7v6M9 10l3-3 3 3"/></svg>
    <span>{e.severity === 'serious' ? t('share.storySerious') : t('share.story')}</span>
  </button>}
  <a class="btn btn-ghost" href={`https://wa.me/?text=${encodeURIComponent(`${text} ${url}`)}`} target="_blank" rel="noopener">WhatsApp</a>
  <a class="btn btn-ghost" href={`https://x.com/intent/post?text=${encodeURIComponent(text)}&url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">{t('share.x')}</a>
  <button type="button" class="btn btn-ghost" data-copy={url}><span>{t('share.copy')}</span></button>
</div>
