---
// A Big Story card: news, not a protest. Never a vibe sticker or volume meter (those measure
// protests). `compact` is the home-page headline row; a story about deaths uses Serious Mode
// (grey, red border, no tilt) like a protest card would.
import { placeNames, storyUrl, type Story } from '../lib/stories';
import { fmtDay, pct, tilt } from '../lib/format';
import { langOf, useT } from '../i18n';
interface Props { s: Story; compact?: boolean; headingLevel?: 'h2' | 'h3' }
const { s, compact = false, headingLevel = 'h3' } = Astro.props;
const lang = langOf(Astro.url);
const t = useT(lang);
const H = headingLevel;
const textLang = lang !== 'en' ? 'en' : undefined; // story text is English only for now
const label = `${t('big.label')} · ${s.status === 'developing' ? t('big.developing') : t('big.settled')}`;
const meta = `${t('card.meta', { n: s.publishers, pct: pct(s.confidence) })} · ${t('big.checked', { date: fmtDay(s.verifiedAt.slice(0, 10), false, lang) })}`;
---
{compact ? (
  <article class:list={['story-row card lift relative flex h-full flex-col gap-1.5 p-4', s.serious ? 'serious' : 'v-story']}>
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[12px]">
      <span class:list={['sticker !px-2 !py-1', s.serious ? 's-tense' : 's-story']}>{label}</span>
      <span class="mono muted text-muted">{placeNames(s, lang)}</span>
    </p>
    <H class="text-[18px] leading-[1.1]" lang={textLang}>
      <a href={storyUrl(s)} class="no-underline after:absolute after:inset-0 after:content-['']">{s.title}</a>
    </H>
    <p class="mono muted mt-auto text-muted">{meta}</p>
  </article>
) : (
  <article class:list={['card lift flex h-full flex-col p-5', s.serious ? 'serious' : 'v-story tilt']} style={s.serious ? undefined : `--tilt: ${tilt(s.slug)}`}>
    <div class="flex flex-wrap items-center gap-2">
      <span class:list={['sticker', s.serious ? 's-tense' : 's-story']}>{label}</span>
      <span class="cause">{t(`big.topic.${s.topic}` as 'big.topic.sport')}</span>
    </div>
    <H class="mt-4 text-[22px] leading-[1.05]" lang={textLang}>
      <a href={storyUrl(s)} class="no-underline after:absolute after:inset-0 after:content-['']">{s.title}</a>
    </H>
    <p class="muted mt-2 text-[14px] font-semibold text-muted">
      {placeNames(s, lang)} · {t('card.since', { date: fmtDay(s.startedOn, false, lang) })}
    </p>
    <p class="mt-3 line-clamp-3 text-[15px] leading-snug" lang={textLang}>{s.dek}</p>
    <p class="mono muted mt-auto pt-4 text-muted">{meta}</p>
  </article>
)}
