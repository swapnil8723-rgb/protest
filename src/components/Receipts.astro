---
import { isUnverified, type ProtestEvent } from '../lib/data';
import { fmtDay, pct } from '../lib/format';
import { CONTACT } from '../site';
import { href, langOf, useT } from '../i18n';
interface Props { e: ProtestEvent }
const { e } = Astro.props;
const lang = langOf(Astro.url);
const t = useT(lang);
const seg = Math.round(e.confidence * 5);
const reader = isUnverified(e);
// Newest report first; numbers stay the same, so [3] in the text still points at receipt 3.
const sources = [...e.sources].sort((a, b) => (b.publishedAt ?? '').localeCompare(a.publishedAt ?? '') || b.n - a.n);
const mail = `<a class="underline" href="mailto:${CONTACT}?subject=Reader report: ${e.slug}">${CONTACT}</a>`;
---
{reader ? (
<section aria-labelledby="receipts" class="rounded-[22px] border-[3px] border-dashed border-reader bg-surface p-5">
  <h2 id="receipts" class="display text-[26px]">{t('receipts.title')}</h2>
  <p class="mt-2 font-semibold">{t('reader.none')}</p>
  <ul class="mt-3 grid gap-2 text-[15px]">
    <li class="flex gap-2"><span aria-hidden="true">✓</span>{t('reader.passed')}</li>
    <li class="flex gap-2"><span aria-hidden="true">…</span>{t('reader.waiting')}</li>
    {(e.reader?.count ?? 1) > 1 && <li class="flex gap-2"><span aria-hidden="true">＋</span>{t('reader.count', { n: e.reader!.count })}</li>}
  </ul>
  {e.reader?.link && (
    <p class="mt-4 text-[14px]">
      <span class="eyebrow block">{t('reader.link')}</span>
      <a href={e.reader.link} rel="nofollow ugc noopener" target="_blank" class="font-semibold break-all underline underline-offset-2">{e.reader.linkHost}</a>
      <span class="text-muted"> · {e.reader.linkOk ? t('reader.linkOk') : t('reader.linkNo')}</span>
    </p>
  )}
  <p class="mt-4 text-[13px] text-muted" set:html={t('reader.wrong', { email: mail })} />
</section>
) : (
<section aria-labelledby="receipts" class="rounded-[22px] border-2 border-hairline bg-surface p-5">
  <div class="flex items-center justify-between gap-3">
    <h2 id="receipts" class="display text-[26px]">{t('receipts.title')}</h2>
    <a href={href(lang, '/how-we-know') + '#confidence'} class="inline-flex min-h-11 items-center text-[13px] font-semibold underline underline-offset-2">{t('receipts.how')}</a>
  </div>
  <div class="mt-3 flex items-center gap-3">
    <span class="flex gap-1" role="img" aria-label={t('receipts.confidence', { pct: pct(e.confidence) })}>
      {[1, 2, 3, 4, 5].map((i) => <i class:list={['block h-3 w-6 rounded-sm border border-black', i <= seg ? 'bg-lime' : 'bg-surface-2']}></i>)}
    </span>
    <span class="mono">{t('receipts.confidence', { pct: pct(e.confidence) })}</span>
  </div>
  <p class="mono mt-1.5 text-muted">{t('receipts.counts', { n: e.publishers, m: e.sources.length })}</p>
  {e.conflicts.length > 0 && (
    <div class="mt-3 rounded-xl border-2 border-dashed border-hairline p-3 text-[14px]">
      <p class="font-semibold">{t('receipts.disagree')}</p>
      <ul class="mt-1 grid gap-1">{e.conflicts.map((c) => <li>{c}</li>)}</ul>
    </div>
  )}
  <ol class="mt-4 grid gap-2.5">
    {sources.map((s) => (
      <li id={`src-${s.n}`} class="flex scroll-mt-24 gap-3">
        <span class="mono mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-md bg-surface-2">{s.n}</span>
        <span class="min-w-0">
          <a href={s.url} rel="nofollow noopener" target="_blank" class="font-semibold leading-snug underline-offset-2 hover:underline">{s.title}</a>
          <span class="mono block text-muted">{s.publisher}{s.publishedAt ? ` · ${fmtDay(s.publishedAt.slice(0, 10), true, lang)}` : ''}</span>
        </span>
      </li>
    ))}
  </ol>
  {lang !== 'en' && <p class="mt-3 text-[13px] text-muted">{t('lang.sources')}</p>}
  {e.origin === 'reader' && <p class="mt-3 text-[13px] text-muted">{t('receipts.firstFlagged')}</p>}
  <p class="mt-4 text-[13px] text-muted">{t('receipts.footer')} <a class="underline" href={href(lang, '/how-we-know') + '#corrections'}>{t('receipts.tellUs')}</a>.</p>
</section>
)}
