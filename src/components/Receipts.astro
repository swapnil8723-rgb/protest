---
import type { ProtestEvent } from '../lib/data';
import { fmtDay, pct } from '../lib/format';
interface Props { e: ProtestEvent }
const { e } = Astro.props;
const seg = Math.round(e.confidence * 5);
---
<section aria-labelledby="receipts" class="rounded-[22px] border-2 border-hairline bg-surface p-5">
  <div class="flex items-center justify-between gap-3">
    <h2 id="receipts" class="display text-[26px]">Receipts</h2>
    <a href="/how-we-know#confidence" class="text-[13px] font-semibold underline underline-offset-2">How we score</a>
  </div>
  <div class="mt-3 flex items-center gap-3">
    <span class="flex gap-1" role="img" aria-label={`Confidence ${pct(e.confidence)}`}>
      {[1, 2, 3, 4, 5].map((i) => <i class:list={['block h-3 w-6 rounded-sm border border-black', i <= seg ? 'bg-lime' : 'bg-surface-2']}></i>)}
    </span>
    <span class="mono">{pct(e.confidence)} confidence</span>
  </div>
  <p class="mono mt-1.5 text-muted">{e.publishers} independent newsrooms · {e.sources.length} reports read</p>
  {e.conflicts.length > 0 && (
    <div class="mt-3 rounded-xl border-2 border-dashed border-hairline p-3 text-[14px]">
      <p class="font-semibold">Where sources disagree</p>
      <ul class="mt-1 grid gap-1">{e.conflicts.map((c) => <li>{c}</li>)}</ul>
    </div>
  )}
  <ol class="mt-4 grid gap-2.5">
    {e.sources.map((s) => (
      <li id={`src-${s.n}`} class="flex scroll-mt-24 gap-3">
        <span class="mono mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-md bg-surface-2">{s.n}</span>
        <span class="min-w-0">
          <a href={s.url} rel="nofollow noopener" target="_blank" class="font-semibold leading-snug underline-offset-2 hover:underline">{s.title}</a>
          <span class="mono block text-muted">{s.publisher}{s.publishedAt ? ` · ${fmtDay(s.publishedAt.slice(0, 10))}` : ''}</span>
        </span>
      </li>
    ))}
  </ol>
  <p class="mt-4 text-[13px] text-muted">Summary written by AI from these reports and checked by rules; no text is copied. Spot an error? <a class="underline" href="/how-we-know#corrections">Tell us</a>.</p>
</section>
