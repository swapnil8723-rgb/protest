---
// The About and Privacy pages: the text is in src/i18n/pages.ts, the links are filled in here.
import Base from '../layouts/Base.astro';
import { COUNTRIES, RULES } from '../../pipeline/config.ts';
import { CONTACT, PUBLISHER, SITE } from '../site';
import { breadcrumbs, org } from '../lib/seo';
import { fmtDate, href, langOf, useT } from '../i18n';
import { howContent } from '../i18n/how';
import { INFO_UPDATED, infoContent, type InfoKey } from '../i18n/pages';

interface Props { page: InfoKey }
const { page } = Astro.props;
const lang = langOf(Astro.url);
const t = useT(lang);
const c = infoContent(page, lang);
const path = `/${page}`;
const link = (url: string, text: string, ext = false) => `<a class="prose-link" href="${url}"${ext ? ' rel="noopener"' : ''}>${text}</a>`;
const vars: Record<string, string> = {
  email: link(`mailto:${CONTACT}`, CONTACT),
  publisher: link(PUBLISHER.url, PUBLISHER.name, true),
  kryvault: link('https://kryvault.com/', 'KryVault', true),
  how: link(href(lang, '/how-we-know'), howContent(lang).h1),
  privacy: link(href(lang, '/privacy'), t('footer.privacy')),
  add: link(href(lang, '/add'), t('footer.add')),
  countries: String(COUNTRIES.length),
  min: String(RULES.minPublishers),
};
const fill = (s: string) => s.replace(/\{(\w+)\}/g, (m, k) => vars[k] ?? m);
const crumbs: [string, string][] = [[t('crumb.home'), href(lang, '/')], [c.h1, href(lang, path)]];
const about = { '@context': 'https://schema.org', '@type': 'AboutPage', url: SITE + href(lang, path), name: c.h1, dateModified: INFO_UPDATED[page], mainEntity: org };
---
<Base title={c.title} description={c.description} path={path} modified={INFO_UPDATED[page]} jsonLd={page === 'about' ? [about, breadcrumbs(crumbs)] : [breadcrumbs(crumbs)]}>
  <article class="wrap max-w-4xl pt-10">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1 class="mt-3 text-[clamp(32px,10.5vw,44px)] sm:text-[72px]">{c.h1}</h1>
    <p class="mt-5 text-[19px] leading-relaxed sm:text-[21px]" set:html={fill(c.intro)} />

    {c.sections.map((s) => (
      <section class="mt-14" aria-labelledby={s.id}>
        <h2 id={s.id} class="text-[28px] sm:text-[36px]">{s.h}</h2>
        {s.p?.map((x) => <p class="mt-4 text-[17px] leading-relaxed [overflow-wrap:anywhere]" set:html={fill(x)} />)}
        {s.list && (
          <ul class="mt-5 grid gap-3 rounded-[18px] border-2 border-hairline bg-surface p-5 text-[16px] leading-relaxed [overflow-wrap:anywhere]">
            {s.list.map((x) => <li set:html={fill(x)} />)}
          </ul>
        )}
        {s.after?.map((x) => <p class="mt-4 text-[17px] leading-relaxed" set:html={fill(x)} />)}
      </section>
    ))}

    <p class="mono mt-14 text-muted">{c.updated}: <time datetime={INFO_UPDATED[page]}>{fmtDate(INFO_UPDATED[page], lang)}</time></p>
  </article>
</Base>
