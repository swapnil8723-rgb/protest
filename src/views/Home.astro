---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import { cname, COUNTRIES, countryOf, countryUrl, eventUrl, events, inCountry, isUnverified, live, liveVerified, lastRunAt, wrapped } from '../lib/data';
import { isSerious, vibeClass, vibeLabel } from '../lib/format';
import { itemList, org, website } from '../lib/seo';
import { href, langOf, useT } from '../i18n';
import { loc } from '../i18n/event';

const lang = langOf(Astro.url);
const t = useT(lang);
const pins = events
  .filter((e) => e.isOngoing || Date.now() - Date.parse(e.lastReportAt) < 4 * 864e5)
  .slice(0, 120)
  .map((raw) => {
    const e = loc(raw, lang);
    return {
      lat: e.place.lat,
      lng: e.place.lng,
      vibe: isUnverified(e) ? 'reader' : vibeClass(e),
      serious: isSerious(e),
      title: e.title,
      url: eventUrl(raw, lang),
      place: `${e.place.city}, ${cname(countryOf(e), lang)}`,
      why: e.tea.why,
      label: isUnverified(e) ? t('vibe.reader') : vibeLabel(e, lang),
    };
  });
const liveCountries = new Set(liveVerified.map((e) => e.place.country)).size;
const loudest = live.slice(0, 6);
const india = events.filter((e) => e.place.country === 'in').slice(0, 4);
const recentlyWrapped = wrapped.slice(0, 4);
const ticker = (live.length ? live : events).slice(0, 14).map((raw) => ({ raw, e: loc(raw, lang) }));
const totalSources = events.reduce((n, e) => n + e.sources.length, 0);
const causes = [...new Map(events.flatMap((e) => e.causes).map((c) => [c, 0])).keys()].map((c) => [c, events.filter((e) => e.causes.includes(c)).length] as const).sort((a, b) => b[1] - a[1]).slice(0, 14);
const india_ = COUNTRIES.find((c) => c.iso === 'in')!;
---
<Base
  title={t('home.title')}
  description={t('home.description')}
  path="/"
  jsonLd={[website, { '@context': 'https://schema.org', ...org }, itemList(live, t('home.listName'), lang)]}
>
  <section class="relative overflow-hidden border-b border-hairline">
    <div class="wrap grid items-center gap-6 pb-10 pt-8 lg:grid-cols-[1.05fr_1fr] lg:gap-4 lg:pb-16 lg:pt-14">
      <div class="relative z-10">
        <p class="flex flex-wrap items-center gap-2">
          <span class="sticker s-heating-up live"><span class="dot" aria-hidden="true"></span>{t('home.live')}</span>
          <span class="mono text-muted">{t('home.updated')} <time data-rel datetime={lastRunAt}>{t('time.recently')}</time> · {t('home.checkedHourly')}</span>
        </p>
        <h1 class="hero mt-5">
          {t('home.heroBefore')} <span class="loud" lang="en">LOUD</span> {t('home.heroAfter')}
        </h1>
        <p class="mt-5 max-w-[34rem] text-[18px] leading-relaxed text-muted sm:text-[20px]" set:html={t('home.lede').replace('<strong>', '<strong class="text-ink">')} />
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={href(lang, '/today')} class="btn btn-primary">{t('home.seeToday')}</a>
          <a href={href(lang, '/add')} class="btn btn-candy">{t('home.add')}</a>
          <a href={href(lang, '/how-we-know')} class="btn btn-ghost">{t('home.how')}</a>
        </div>
        <dl class="mt-8 grid max-w-md grid-cols-3 gap-3">
          <div><dt class="eyebrow">{t('home.liveNow')}</dt><dd class="display text-[40px] leading-none">{liveVerified.length}</dd></div>
          <div><dt class="eyebrow">{t('home.countries')}</dt><dd class="display text-[40px] leading-none">{liveCountries}</dd></div>
          <div><dt class="eyebrow">{t('home.receipts')}</dt><dd class="display text-[40px] leading-none">{totalSources}</dd></div>
        </dl>
      </div>

      <div class="globe-wrap relative" data-globe>
        <canvas class="globe aspect-square w-full touch-none select-none" aria-label={t('home.globe', { n: pins.length })} role="img"></canvas>
        <p data-status class="sr-only" aria-live="polite"></p>
        <div class="absolute bottom-2 left-1/2 flex -translate-x-1/2 items-center gap-2 rounded-full border-2 border-black bg-surface px-2 py-1.5 shadow-[4px_4px_0_#000]">
          <button type="button" data-prev class="globe-btn" aria-label={t('home.prev')}>‹</button>
          <span data-count class="mono min-w-[56px] text-center">{pins.length} {t('globe.pins')}</span>
          <button type="button" data-next class="globe-btn" aria-label={t('home.next')}>›</button>
          <span class="mx-1 h-5 w-px bg-hairline" aria-hidden="true"></span>
          <button type="button" data-zoom-out class="globe-btn" aria-label={t('home.zoomOut')}>−</button>
          <button type="button" data-zoom-in class="globe-btn" aria-label={t('home.zoomIn')}>+</button>
        </div>
        <div data-drawer hidden aria-live="polite"></div>
        <script type="application/json" id="pins" set:html={JSON.stringify(pins)} />
      </div>
    </div>

    {ticker.length > 0 && (
      <div class="overflow-hidden border-t-[3px] border-black bg-yellow py-2.5 text-black" aria-label={t('home.ticker')}>
        <div class="marquee">
          {[0, 1].map((copy) => (
            <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
              {ticker.map(({ raw, e }) => (
                <li class="flex items-center gap-2 px-5 text-[15px] font-bold whitespace-nowrap">
                  <span aria-hidden="true">●</span>
                  <a href={eventUrl(raw, lang)} class="no-underline hover:underline" tabindex={copy === 1 ? -1 : undefined}>
                    <span class="uppercase">{e.place.city}</span> · {e.seoTitle?.replace(new RegExp(`^${e.place.city}\\s*`, 'i'), '') || e.title} · {isUnverified(e) ? t('vibe.reader') : vibeLabel(e, lang)}
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    )}
  </section>

  <section class="wrap mt-14" aria-labelledby="loudest">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 id="loudest" class="text-[34px] sm:text-[44px]">{t('home.loudest')}</h2>
      <a href={href(lang, '/today')} class="font-semibold underline underline-offset-4">{t('home.allLive', { n: live.length })}</a>
    </div>
    {loudest.length ? (
      <div class="mt-8 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">{loudest.map((e) => <EventCard e={e} />)}</div>
    ) : (
      <p class="mt-6 text-[18px] text-muted">{t('home.quiet')}</p>
    )}
  </section>

  {india.length > 0 && (
    <section class="wrap mt-20" aria-labelledby="india">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 id="india" class="text-[34px] sm:text-[44px]">{t('home.india')}</h2>
        <a href={countryUrl(india_, lang)} class="font-semibold underline underline-offset-4">{t('home.indiaLink')}</a>
      </div>
      <div class="mt-8 grid gap-7 sm:grid-cols-2 lg:grid-cols-4">{india.map((e) => <EventCard e={e} />)}</div>
    </section>
  )}

  <section class="wrap mt-20" aria-labelledby="countries">
    <h2 id="countries" class="text-[34px] sm:text-[44px]">{t('home.pick')}</h2>
    <ul class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {COUNTRIES.map((c, i) => {
        const all = inCountry(c.iso);
        const n = all.filter((e) => e.isOngoing).length;
        return (
          <li>
            <a href={countryUrl(c, lang)} class:list={['country-tile card lift flex items-center justify-between gap-3 p-4 no-underline', ['v-heating-up', 'v-cooling-down', 'v-wrapped-up'][i % 3]]}>
              <span>
                <span class="display block text-[20px] leading-tight">{cname(c, lang)}</span>
                <span class="mono text-muted">{t('home.tile', { live: n, all: all.length })}</span>
              </span>
              <span class="mono grid h-10 w-10 shrink-0 place-items-center rounded-full border-2 border-black bg-surface-2 text-[12px] uppercase">{c.iso}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  {causes.length > 0 && (
    <section class="wrap mt-20" aria-labelledby="causes">
      <h2 id="causes" class="text-[34px] sm:text-[44px]">{t('home.mad')}</h2>
      <ul class="mt-6 flex flex-wrap gap-2.5">
        {causes.map(([c, n]) => <li><a href={`${href(lang, '/today')}?cause=${c}`} rel="nofollow" class="cause !px-4 !py-2.5 !text-[15px]">{t(`cause.${c}` as 'cause.water')}<span class="mono ml-2 text-muted">{n}</span></a></li>)}
      </ul>
    </section>
  )}

  {recentlyWrapped.length > 0 && (
    <section class="wrap mt-20" aria-labelledby="wrapped">
      <h2 id="wrapped" class="text-[34px] sm:text-[44px]">{t('home.wrapped')}</h2>
      <div class="mt-8 grid gap-7 sm:grid-cols-2 lg:grid-cols-4">{recentlyWrapped.map((e) => <EventCard e={e} />)}</div>
    </section>
  )}

  <section class="wrap mt-24" aria-labelledby="trust">
    <div class="card grid gap-8 p-6 sm:p-10 lg:grid-cols-[1fr_2fr]" style="--vibe: var(--violet)">
      <div>
        <p class="eyebrow">{t('home.funny')}</p>
        <h2 id="trust" class="mt-3 text-[34px] sm:text-[44px]">{t('home.how')}</h2>
      </div>
      <ol class="grid gap-6 sm:grid-cols-3">
        <li><p class="display text-[48px] leading-none text-pink">2+</p><p class="mt-2 font-semibold">{t('home.trust1')}</p></li>
        <li><p class="display text-[48px] leading-none text-cyan">%</p><p class="mt-2 font-semibold">{t('home.trust2')}</p></li>
        <li><p class="display text-[48px] leading-none text-lime">0</p><p class="mt-2 font-semibold">{t('home.trust3')}</p></li>
      </ol>
      <a href={href(lang, '/how-we-know')} class="btn btn-primary lg:col-start-2 lg:justify-self-start">{t('home.method')}</a>
    </div>
  </section>
</Base>

<style>
  .hero { font-size: clamp(44px, 8.4vw, 104px); line-height: 0.9; letter-spacing: -0.045em; }
  .loud {
    display: inline-block; background: var(--pink); color: #0b0b12; padding: 0 0.12em; margin: 0 0.02em;
    border: 4px solid #0b0b12; border-radius: 0.18em; transform: rotate(-3deg); box-shadow: 6px 6px 0 #0b0b12;
  }
  :root:not([data-theme='light']) .loud { box-shadow: 6px 6px 0 var(--cyan); }
  .globe-wrap { max-width: 640px; justify-self: center; width: 100%; }
  .globe { cursor: grab; opacity: 0.25; transition: opacity 600ms ease; }
  .globe-wrap:global(.ready) .globe { opacity: 1; }
  .globe:active { cursor: grabbing; }
  .globe-btn { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 99px; font: 800 20px/1 var(--font-display); }
  .globe-btn:hover { background: var(--surface-2); }
  [data-drawer]:not([hidden]) { position: absolute; left: 50%; bottom: 64px; transform: translateX(-50%); width: min(360px, 92%); padding: 18px; z-index: 5; }
  :global(.drawer-x) { width: 34px; height: 34px; border-radius: 99px; font-size: 24px; line-height: 1; }
  :global(.drawer-x:hover) { background: var(--surface-2); }
</style>

<script>
  import '../scripts/globe.ts';
</script>
