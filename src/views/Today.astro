---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import { allCauses, cname, COUNTRIES, events, lastRunAt, live } from '../lib/data';
import { fmtDay } from '../lib/format';
import { breadcrumbs, itemList } from '../lib/seo';
import { href, langOf, useT } from '../i18n';

const lang = langOf(Astro.url);
const t = useT(lang);
// Live first, then anything with a report in the last 3 days (so "today" never looks empty after a quiet night).
const list = events.filter((e) => e.isOngoing || Date.now() - Date.parse(e.lastReportAt) < 3 * 864e5);
const today = fmtDay(new Date().toISOString().slice(0, 10), true, lang);
const countries = COUNTRIES.filter((c) => list.some((e) => e.place.country === c.iso));
const causes = allCauses.filter((c) => list.some((e) => e.causes.includes(c)));
const counts = { one: t('today.count', { n: 1 }).replace('1', '{n}'), other: t('today.count', { n: 7 }).replace('7', '{n}') };
---
<Base
  title={t('today.title', { date: today })}
  description={t('today.description', { live: live.length, countries: new Set(live.map((e) => e.place.country)).size })}
  path="/today"
  jsonLd={[itemList(list, t('today.h1'), lang), breadcrumbs([[t('crumb.home'), href(lang, '/')], [t('today.h1'), href(lang, '/today')]])]}
>
  <div class="wrap pt-10">
    <p class="eyebrow">{t('today.updated')} <time data-rel datetime={lastRunAt}>{t('time.recently')}</time></p>
    <h1 class="mt-3 text-[44px] sm:text-[72px]">{t('today.h1')}</h1>
    <p class="mt-4 max-w-2xl text-[18px] text-muted" set:html={t('today.lede', { live: live.length, past: list.length - live.length }).replace('<strong>', '<strong class="text-ink">')} />

    <div class="mt-8 grid gap-4" role="group" aria-label={t('today.filters')}>
      <div class="flex flex-wrap items-center gap-2">
        <span class="eyebrow mr-1">{t('today.country')}</span>
        <button type="button" class="cause" data-f="country" data-v="" aria-pressed="true">{t('today.all')}</button>
        {countries.map((c) => <button type="button" class="cause" data-f="country" data-v={c.iso} aria-pressed="false">{cname(c, lang).toLowerCase()}</button>)}
      </div>
      {causes.length > 0 && (
        <div class="flex flex-wrap items-center gap-2">
          <span class="eyebrow mr-1">{t('today.cause')}</span>
          <button type="button" class="cause" data-f="cause" data-v="" aria-pressed="true">{t('today.all')}</button>
          {causes.map((c) => <button type="button" class="cause" data-f="cause" data-v={c} aria-pressed="false">{t(`cause.${c}` as 'cause.water')}</button>)}
        </div>
      )}
      <label class="flex items-center gap-2 text-[15px] font-semibold">
        <input type="checkbox" id="live-only" class="h-5 w-5 accent-[#FF3D81]" /> {t('today.liveOnly')}
      </label>
    </div>

    <p id="count" class="mono mt-6 text-muted" aria-live="polite" data-forms={JSON.stringify(counts)} data-locale={lang}>{t('today.count', { n: list.length })}</p>
    <ul id="list" class="mt-4 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
      {list.map((e) => (
        <li data-country={e.place.country} data-causes={e.causes.join(' ')} data-live={e.isOngoing ? '1' : '0'}>
          <EventCard e={e} headingLevel="h2" />
        </li>
      ))}
    </ul>
    <p id="empty" class="mt-10 text-[20px] font-semibold" hidden>{t('today.empty')}</p>

    <div class="card mt-14 flex flex-col items-start gap-4 p-6 sm:flex-row sm:items-center sm:justify-between" style="--vibe: var(--reader)">
      <p class="text-[18px] font-semibold">{t('today.missing')}</p>
      <a href={href(lang, '/add')} class="btn btn-candy shrink-0">{t('home.add')}</a>
    </div>
  </div>
</Base>

<script>
  const state: Record<string, string> = { country: '', cause: '' };
  const params = new URLSearchParams(location.search);
  state.country = params.get('country') ?? '';
  state.cause = params.get('cause') ?? '';
  const liveOnly = document.getElementById('live-only') as HTMLInputElement;
  liveOnly.checked = params.get('live') === '1';
  const countEl = document.getElementById('count')!;
  const forms: Record<string, string> = JSON.parse(countEl.dataset.forms || '{}');
  const plural = new Intl.PluralRules(countEl.dataset.locale || 'en');

  function apply() {
    let n = 0;
    for (const li of document.querySelectorAll<HTMLElement>('#list > li')) {
      const ok =
        (!state.country || li.dataset.country === state.country) &&
        (!state.cause || (li.dataset.causes ?? '').split(' ').includes(state.cause)) &&
        (!liveOnly.checked || li.dataset.live === '1');
      li.hidden = !ok;
      if (ok) n++;
    }
    for (const b of document.querySelectorAll<HTMLButtonElement>('button[data-f]')) {
      b.setAttribute('aria-pressed', String(state[b.dataset.f!] === b.dataset.v));
    }
    countEl.textContent = (forms[plural.select(n)] ?? forms.other ?? '{n}').replace('{n}', String(n));
    document.getElementById('empty')!.hidden = n > 0;
    const q = new URLSearchParams();
    if (state.country) q.set('country', state.country);
    if (state.cause) q.set('cause', state.cause);
    if (liveOnly.checked) q.set('live', '1');
    history.replaceState(null, '', q.toString() ? `?${q}` : location.pathname);
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>('button[data-f]')) {
    b.addEventListener('click', () => {
      state[b.dataset.f!] = b.dataset.v!;
      apply();
    });
  }
  liveOnly.addEventListener('change', apply);
  apply();
</script>
