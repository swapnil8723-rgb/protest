---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | LOUD" path="/404" noindex>
  <div class="wrap grid min-h-[60vh] place-content-center py-20 text-center">
    <p class="sticker s-heating-up mx-auto"><span class="dot" aria-hidden="true"></span>404</p>
    <h1 class="mt-6 text-[48px] sm:text-[80px]">This page left the march early.</h1>
    <p class="mx-auto mt-4 max-w-md text-[18px] text-muted">The link may be old, or the protest was never confirmed by two newsrooms.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/today" class="btn btn-primary">See today's protests</a>
      <a href="/" class="btn btn-ghost">Back to the globe</a>
    </div>
  </div>
</Base>
