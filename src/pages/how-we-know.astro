---
import Base from '../layouts/Base.astro';
import { COUNTRIES, RULES } from '../../pipeline/config.ts';
import { CONTACT, BRAND } from '../site';
import { breadcrumbs, org } from '../lib/seo';
import { events, lastRunAt } from '../lib/data';

const vibes = [
  ['Heating up', 's-heating-up', 'More reports in the last 24 hours than in the 24 hours before.'],
  ['Peak loud', 's-peak-loud', `In the top ${RULES.peakTopShare * 100}% of live protests by report volume (and at least ${RULES.minPeakVolume} reports in 48 hours).`],
  ['Cooling down', 's-cooling-down', 'Report volume flat or falling over the last 24 hours.'],
  ['Wrapped up', 's-wrapped-up', `Sources say it ended, was called off or demands were met, or there have been no new reports for ${RULES.wrapAfterHours} hours. One-day marches wrap at the end of their local day.`],
  ['Serious', 's-tense', `Any reported death, serious injury or hospitalisation, or ${RULES.massArrests}+ arrests or detentions — and protests that are about a death, suicide or sexual violence. The card turns grey and every joke is removed.`],
];
const steps = [
  ['Listen', 'Every hour we pull the GDELT 2.0 event feed (news articles its coders tag as protests, every 15 minutes, worldwide) plus RSS feeds from major Indian newsrooms.'],
  ['Read', 'We open each article once and read it. Its text is used only in memory to judge and summarise. We never store or republish it.'],
  ['Judge', 'An AI classifier checks each article: is this a real, physical protest (not a diplomatic "protest", an opinion piece or an election rally), where did it happen, and is it new or part of one we already track?'],
  ['Place', `The city is matched against the GeoNames gazetteer. Pins sit on the city centre, never on a street, venue or live route. If a place is ambiguous, we drop it rather than guess.`],
  ['Corroborate', `Nothing goes public until at least ${RULES.minPublishers} independent newsrooms report it. Sister titles from one media group count once; wire copy re-published by many sites counts once; syndication farms and aggregators don't count at all.`],
  ['Write', 'AI writes an original card from up to 10 reports: why, what they want, what changed, both sides, numbers only when a source states them, each with its source number.'],
  ['Check', 'Rules, not AI, set the vibe, "is it still on", Serious Mode and the confidence score. A number with no source is deleted. Banned words (like "mob" or "brave") send the card to a human.'],
  ['Review', `A human reviews anything involving deaths, injuries or mass arrests, the ${RULES.reviewTopN} biggest live protests, confidence below ${Math.round(RULES.reviewConfidence * 100)}%, and sources that disagree, by tapping Approve or Reject on their phone. If no reviewer is on duty, flagged cards publish only once at least three independent newsrooms report them, and never with tone problems or low confidence.`],
];
---
<Base
  title={`How we know: ${BRAND}'s method for tracking protests`}
  description="How LOUD finds, verifies and summarises protests: at least two independent newsrooms, a published confidence formula, automatic Serious Mode, human review and corrections."
  path="/how-we-know"
  jsonLd={[{ '@context': 'https://schema.org', ...org }, breadcrumbs([['Home', '/'], ['How we know', '/how-we-know']])]}
>
  <article class="wrap max-w-4xl pt-10">
    <p class="eyebrow">The receipts for our receipts</p>
    <h1 class="mt-3 text-[44px] sm:text-[72px]">How we know</h1>
    <p class="mt-5 text-[19px] leading-relaxed sm:text-[21px]">
      {BRAND} is a neutral protest tracker. The interface is playful; the facts are not. We don't take sides, we don't add adjectives,
      and we show you exactly where every line comes from. Right now we track <strong>{events.length}</strong> protests across
      {' '}{COUNTRIES.map((c) => c.name).join(', ')}.
    </p>

    <section class="mt-14" aria-labelledby="pipeline">
      <h2 id="pipeline" class="text-[32px] sm:text-[40px]">From headline to card, every hour</h2>
      <ol class="mt-7 grid gap-4">
        {steps.map(([t, d], i) => (
          <li class="flex gap-4 rounded-[18px] border-2 border-hairline bg-surface p-5">
            <span class="display grid h-11 w-11 shrink-0 place-items-center rounded-xl border-2 border-black bg-yellow text-[20px] text-black">{i + 1}</span>
            <span><strong class="display block text-[22px]">{t}</strong><span class="mt-1 block">{d}</span></span>
          </li>
        ))}
      </ol>
      <p class="mono mt-4 text-muted">Last run <time data-rel datetime={lastRunAt}>recently</time>.</p>
    </section>

    <section class="mt-16" aria-labelledby="vibes">
      <h2 id="vibes" class="text-[32px] sm:text-[40px]">What the vibe stickers mean</h2>
      <dl class="mt-7 grid gap-4">
        {vibes.map(([n, cls, d]) => (
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:gap-5">
            <dt class="sm:w-40"><span class:list={['sticker', cls]}><span class="dot" aria-hidden="true"></span>{n}</span></dt>
            <dd>{d}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-6"><strong>Is it still on?</strong> YES means sources show it continuing (or it is a one-day action happening today, local time). NO says why: it ended, was called off, demands were met, or it went quiet for {RULES.wrapAfterHours} hours. If our checks pause, pages say so at the top.</p>
    </section>

    <section class="mt-16" aria-labelledby="confidence">
      <h2 id="confidence" class="text-[32px] sm:text-[40px]">The confidence score</h2>
      <p class="mt-4">A simple, published formula, not a black box:</p>
      <ul class="mono mt-4 grid gap-1.5 rounded-[18px] border-2 border-hairline bg-surface p-5 text-[14px]">
        <li>2 independent newsrooms → 70%</li>
        <li>3 → 80% · 4 → 86% · 5 or more → 90%</li>
        <li>+5 points if one is an established national or wire newsroom</li>
        <li>−15 points if sources disagree on numbers or status (we show where)</li>
        <li>−5 points if an "ongoing" protest has had no report for 72 hours</li>
        <li>capped between 30% and 97%: we are never 100% sure</li>
      </ul>
      <p class="mt-4">Single-source reports are never shown. Below {Math.round(RULES.reviewConfidence * 100)}%, a card stays hidden until a human approves it.</p>
    </section>

    <section class="mt-16" aria-labelledby="rules">
      <h2 id="rules" class="text-[32px] sm:text-[40px]">House rules</h2>
      <ul class="mt-6 grid gap-3 text-[17px]">
        <li><strong>Both sides, with receipts.</strong> Every card states what protesters demand and what the authorities said, each linked to sources.</li>
        <li><strong>No adjectives about people.</strong> No "brave", no "violent mob". Claims are attributed: "police said", "organisers claimed".</li>
        <li><strong>No names or faces of protesters.</strong> We name organisations, parties and public officials, never ordinary participants, the injured or the detained.</li>
        <li><strong>City-level locations only.</strong> Never exact gathering points or live movement.</li>
        <li><strong>Original words only.</strong> Summaries are written fresh; we link out to the reporting and never copy text or photos.</li>
        <li><strong>India's official borders.</strong> Maps use Natural Earth's India point-of-view boundaries, drawing Jammu &amp; Kashmir (including Gilgit-Baltistan and PoK), Ladakh (including Aksai Chin) and Arunachal Pradesh as part of India, per India's official position.</li>
        <li><strong>Archive stays up.</strong> Wrapped-up protests keep their page so anyone can check what happened.</li>
      </ul>
    </section>

    <section class="mt-16" aria-labelledby="limits">
      <h2 id="limits" class="text-[32px] sm:text-[40px]">What we can miss</h2>
      <p class="mt-4">We see what newsrooms report. Small or rural protests that get no coverage, or coverage only in languages our sources don't reach, can be missing or late. Crowd sizes are whatever sources state, and police and organisers often disagree. When they do, we show both. AI can make mistakes; that's why rules double-check it and humans review the sensitive cases.</p>
    </section>

    <section class="mt-16" aria-labelledby="corrections">
      <h2 id="corrections" class="text-[32px] sm:text-[40px]">Corrections</h2>
      <p class="mt-4">Spotted something wrong? Email <a class="prose-link" href={`mailto:${CONTACT}?subject=Correction`}>{CONTACT}</a> with the page link and a source. We fix verified errors fast, and the page's "updated" time changes when we do.</p>
    </section>

    <section class="mt-16" aria-labelledby="credits">
      <h2 id="credits" class="text-[32px] sm:text-[40px]">Data credits</h2>
      <ul class="mt-4 grid gap-1.5">
        <li>Event discovery: <a class="prose-link" href="https://www.gdeltproject.org/" rel="noopener">The GDELT Project</a></li>
        <li>Places: <a class="prose-link" href="https://www.geonames.org/" rel="noopener">GeoNames</a> (CC BY 4.0)</li>
        <li>Boundaries: <a class="prose-link" href="https://www.naturalearthdata.com/" rel="noopener">Natural Earth</a> (public domain), India point of view</li>
        <li>Reporting: the newsrooms linked on every card</li>
      </ul>
    </section>
  </article>
</Base>
