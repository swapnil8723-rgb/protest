---
// Big Story pages (English only for now, so not generated by scripts/make-lang-pages.mjs).
// The page body lives in src/views/Story.astro.
import View from '../../views/Story.astro';
import { stories } from '../../lib/stories';
export function getStaticPaths() {
  return stories.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
---
<View s={Astro.props.s} />
