---
import Base from '../layouts/Base.astro';
import { COUNTRIES, RULES } from '../../pipeline/config.ts';
import { breadcrumbs } from '../lib/seo';
import { BRAND, CONTACT } from '../site';

const today = new Date().toISOString().slice(0, 10);
const min = new Date(Date.now() - 30 * 864e5).toISOString().slice(0, 10);
const max = new Date(Date.now() + 14 * 864e5).toISOString().slice(0, 10);
const delay = RULES.readerDelayMinutes >= 60 ? `${RULES.readerDelayMinutes / 60} hour` : `${RULES.readerDelayMinutes} minutes`;
---
<Base
  title={`Add a protest to ${BRAND}: report a protest near you`}
  description="Seeing a protest that isn't on the map? Tell us. After a quick automatic check it shows up as a reader report, then turns into a verified card once newsrooms confirm it."
  path="/add"
  jsonLd={[breadcrumbs([['Home', '/'], ['Add a protest', '/add']])]}
>
  <div class="wrap max-w-3xl pt-10">
    <p class="eyebrow">Something's happening and we missed it?</p>
    <h1 class="mt-3 text-[44px] sm:text-[68px]">Add a protest</h1>
    <p class="mt-4 text-[18px] leading-relaxed text-muted">
      Tell us what's going on. In about {delay} it runs through an automatic check, then appears on {BRAND} as an
      <span class="sticker s-reader align-middle"><span class="dot" aria-hidden="true"></span>Reader report</span>
      until two independent newsrooms confirm it.
    </p>

    <ul class="mt-6 grid gap-2 rounded-[18px] border-2 border-hairline bg-surface p-5 text-[15px]">
      <li class="flex gap-2"><span aria-hidden="true">✓</span><span><strong>City or town only.</strong> No street, meeting point, time to gather or route.</span></li>
      <li class="flex gap-2"><span aria-hidden="true">✓</span><span><strong>No names</strong> of people taking part, and no photos. Organisations, unions and parties are fine.</span></li>
      <li class="flex gap-2"><span aria-hidden="true">✓</span><span><strong>Stick to what you know.</strong> Injuries, arrests or violence wait for newsrooms before we show them.</span></li>
      <li class="flex gap-2"><span aria-hidden="true">✓</span><span><strong>A news link helps</strong> it get verified faster. We don't ask for your name or email.</span></li>
    </ul>

    <form id="add-form" class="card mt-8 grid gap-5 p-5 sm:p-7" style="--vibe: var(--reader)" novalidate>
      <label class="field">
        <span class="lbl">What's happening? <em>*</em></span>
        <input name="title" required minlength="8" maxlength="120" placeholder="e.g. Students protest fee hike at state university" />
      </label>

      <div class="grid gap-5 sm:grid-cols-3">
        <label class="field">
          <span class="lbl">City or town <em>*</em></span>
          <input name="city" required maxlength="80" autocomplete="address-level2" placeholder="e.g. Pune" />
        </label>
        <label class="field">
          <span class="lbl">State / region</span>
          <input name="region" maxlength="80" autocomplete="address-level1" placeholder="e.g. Maharashtra" />
        </label>
        <label class="field">
          <span class="lbl">Country <em>*</em></span>
          <select name="country" required>
            {COUNTRIES.map((c) => <option value={c.iso} selected={c.iso === 'in'}>{c.name}</option>)}
          </select>
        </label>
      </div>

      <div class="grid gap-5 sm:grid-cols-[200px_1fr]">
        <label class="field">
          <span class="lbl">Started on <em>*</em></span>
          <input type="date" name="startedOn" required value={today} min={min} max={max} />
        </label>
        <fieldset class="field">
          <legend class="lbl">Is it still on? <em>*</em></legend>
          <div class="mt-1 flex flex-wrap gap-2">
            <label class="pill"><input type="radio" name="stillOn" value="yes" checked /> <span>Yes, it's on</span></label>
            <label class="pill"><input type="radio" name="stillOn" value="soon" /> <span>Coming up</span></label>
            <label class="pill"><input type="radio" name="stillOn" value="no" /> <span>It ended</span></label>
          </div>
        </fieldset>
      </div>

      <label class="field">
        <span class="lbl">Why are people protesting? <em>*</em></span>
        <textarea name="why" required minlength="20" maxlength="600" rows="3" placeholder="What is it about? Stick to facts."></textarea>
      </label>
      <label class="field">
        <span class="lbl">What do they want?</span>
        <textarea name="want" maxlength="600" rows="2" placeholder="Their demands, if you know them."></textarea>
      </label>
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="field">
          <span class="lbl">Organised by</span>
          <input name="organisers" maxlength="160" placeholder="Union, group or party (no individuals)" />
        </label>
        <label class="field">
          <span class="lbl">News link or public post</span>
          <input type="url" name="link" maxlength="500" inputmode="url" placeholder="https://" />
        </label>
      </div>

      <!-- Bots fill every field; people never see this one. -->
      <label class="hp" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off" /></label>

      <label class="flex items-start gap-3 text-[15px]">
        <input type="checkbox" name="agree" required class="mt-1 h-5 w-5 shrink-0 accent-[#ff8a00]" />
        <span>This is true to the best of my knowledge, and it names no private person and no exact meeting spot.</span>
      </label>

      <p id="add-error" class="rounded-xl border-2 border-pink bg-surface-2 p-3 font-semibold" role="alert" hidden></p>
      <button type="submit" class="btn btn-candy justify-self-start" style="box-shadow: 4px 4px 0 var(--black)">Send it</button>
    </form>

    <div id="add-done" class="card mt-8 p-6 sm:p-8" style="--vibe: var(--lime)" hidden tabindex="-1">
      <p class="display text-[34px] leading-tight">Got it. Thank you!</p>
      <p class="mt-3 text-[17px]">In about {delay} our automatic check runs. If it passes, your report shows up as an orange <strong>Reader report</strong> on the map and on <a href="/today" class="underline">Protests today</a>. Once two newsrooms confirm it, it becomes a regular verified card.</p>
      <button type="button" id="add-another" class="btn btn-ghost mt-5">Add another</button>
    </div>

    <p class="mt-8 text-[14px] text-muted">
      Reports that fail the check (not a protest, outside the {COUNTRIES.length} countries we track, unsafe or abusive) are deleted, not published.
      Your IP address is only used, scrambled, to limit reports to 3 a day, and is never stored. Something wrong on a reader report? <a class="underline" href={`mailto:${CONTACT}`}>{CONTACT}</a>.
    </p>
  </div>
</Base>

<style>
  .field { display: grid; gap: 6px; min-width: 0; }
  .lbl { font-weight: 700; font-size: 15px; }
  .lbl em { color: var(--reader); font-style: normal; }
  .field input:not([type='radio']), .field select, .field textarea {
    width: 100%; min-height: 48px; padding: 10px 12px; border-radius: 12px; font-size: 16px;
    background: var(--bg); color: var(--ink); border: 2px solid var(--hairline);
  }
  .field textarea { resize: vertical; line-height: 1.45; }
  .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--reader); }
  .field input::placeholder, .field textarea::placeholder { color: var(--muted); opacity: 0.8; }
  fieldset.field { border: 0; padding: 0; margin: 0; }
  .pill { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px; border-radius: 999px; border: 2px solid var(--hairline); font-weight: 600; cursor: pointer; }
  .pill:has(input:checked) { background: var(--reader); color: var(--black); border-color: var(--black); }
  .pill input { accent-color: var(--black); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>

<script>
  const form = document.getElementById('add-form') as HTMLFormElement;
  const err = document.getElementById('add-error')!;
  const done = document.getElementById('add-done')!;
  const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
  let started = Date.now();

  const fail = (msg: string) => {
    err.textContent = msg;
    err.hidden = false;
    err.scrollIntoView({ block: 'center', behavior: 'smooth' });
  };

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    err.hidden = true;
    if (!form.checkValidity()) {
      const bad = form.querySelector<HTMLElement>(':invalid');
      const name = bad?.getAttribute('name');
      const msg: Record<string, string> = {
        title: 'Add a short headline (at least 8 characters).',
        city: 'Which city or town?',
        why: 'Tell us why people are protesting (a sentence or two).',
        link: 'The link does not look like a web address.',
        startedOn: 'Pick a date within the last 30 days or the next 2 weeks.',
        agree: 'Please tick the box to confirm.',
      };
      bad?.focus();
      return fail(msg[name ?? ''] ?? 'Please check the form.');
    }
    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    btn.disabled = true;
    btn.textContent = 'Sending…';
    try {
      const res = await fetch('/api/report', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ ...data, ms: Date.now() - started }),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) return fail(body.error ?? 'Something went wrong. Please try again.');
      form.hidden = true;
      done.hidden = false;
      done.focus();
      done.scrollIntoView({ block: 'center', behavior: 'smooth' });
    } catch {
      fail('No connection. Please try again.');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send it';
    }
  });

  document.getElementById('add-another')!.addEventListener('click', () => {
    form.reset();
    started = Date.now();
    done.hidden = true;
    form.hidden = false;
    form.scrollIntoView({ block: 'start', behavior: 'smooth' });
  });
</script>
