---
import Base from '../../../layouts/Base.astro';
import EventCard from '../../../components/EventCard.astro';
import { cities, country, countryUrl, lastRunAt, type ProtestEvent } from '../../../lib/data';
import { metaDesc, monthYear } from '../../../lib/format';
import { breadcrumbs, itemList } from '../../../lib/seo';

export function getStaticPaths() {
  return [...cities].map(([key, list]) => {
    const [cc, region, city] = key.split('/');
    return { params: { cc, region, city }, props: { list } };
  });
}
const { list } = Astro.props as { list: ProtestEvent[] };
const { place } = list[0];
const c = country(place.country);
const live = list.filter((e) => e.isOngoing);
const past = list.filter((e) => !e.isOngoing);
const path = `/${place.country}/${place.regionSlug}/${place.citySlug}`;
const month = monthYear(new Date().toISOString().slice(0, 10));
const lede = live.length
  ? `${live.length} protest${live.length === 1 ? ' is' : 's are'} live in ${place.city} right now. ${live.map((e) => e.title).slice(0, 2).join('; ')}.`
  : `No protests are live in ${place.city} right now. Suspiciously quiet. Here's what happened recently.`;
---
<Base
  title={`${place.city} protest today: live updates & what's happening (${month})`}
  description={metaDesc(`${lede} Each protest in ${place.city}, ${place.region || c.name} explained in three lines with sources. Updated every hour.`)}
  path={path}
  jsonLd={[itemList(list, `Protests in ${place.city}`), breadcrumbs([['Home', '/'], [c.name, countryUrl(c)], [place.city, path]])]}
>
  <div class="wrap pt-10">
    <nav aria-label="Breadcrumb" class="mono text-muted"><a href="/" class="hover:underline">Home</a> / <a href={countryUrl(c)} class="hover:underline">{c.name}</a> / {place.city}</nav>
    <p class="eyebrow mt-6">{place.region ? `${place.region}, ` : ''}{c.name} · updated <time data-rel datetime={lastRunAt}>recently</time></p>
    <h1 class="mt-3 text-[44px] sm:text-[72px]">{place.city} protests today</h1>
    <p class="mt-5 max-w-3xl text-[18px] leading-relaxed sm:text-[20px]">{lede}</p>

    <section class="mt-12" aria-labelledby="live">
      <h2 id="live" class="text-[32px] sm:text-[40px]">Still on in {place.city}</h2>
      {live.length ? (
        <div class="mt-7 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">{live.map((e) => <EventCard e={e} />)}</div>
      ) : (
        <p class="mt-4 text-[18px] text-muted">No protests here. Suspiciously quiet.</p>
      )}
    </section>

    {past.length > 0 && (
      <section class="mt-16" aria-labelledby="past">
        <h2 id="past" class="text-[32px] sm:text-[40px]">What happened recently</h2>
        <div class="mt-7 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">{past.map((e) => <EventCard e={e} tiltCard={false} />)}</div>
      </section>
    )}

    <p class="mt-14"><a href={countryUrl(c)} class="btn btn-ghost">All protests in {c.name} →</a></p>
  </div>
</Base>
