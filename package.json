{
  "name": "loud-protest-tracker",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/cards.ts && astro build && node scripts/postbuild.ts",
    "build:site": "astro build && node scripts/postbuild.ts",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.ts",
    "pipeline": "node pipeline/run.ts",
    "cards": "node scripts/cards.ts",
    "map": "node scripts/build-map.ts",
    "gazetteer": "node scripts/build-gazetteer.ts",
    "icons": "node scripts/icons.ts",
    "shot": "node scripts/shot.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/blob": "^2.8.0",
    "astro": "^7.3.5",
    "d3-geo": "^3.1.1",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^26.6.2",
    "@types/topojson-client": "^3.1.5",
    "mapshaper": "^0.7.76",
    "playwright-core": "^1.63.0",
    "satori": "^0.35.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  }
