{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "git log -1 --pretty=%s | grep -qF '[skip vercel]'",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
